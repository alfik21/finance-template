{
  "name": "finance-template",
  "version": "1.8.6",
  "description": "Edisi **Template Spreadsheet Terpadu (Container-Bound)** yang menempel langsung di dalam Google Spreadsheet pembeli.",
  "main": "src/backend/Code.js",
  "scripts": {
    "prepare:fixture": "node scripts/prepare-test-app.js",
    "test": "npm run prepare:fixture && playwright test",
    "test:headed": "npm run prepare:fixture && playwright test --headed",
    "test:ui": "npm run prepare:fixture && playwright test --ui",
    "test:backend": "node --test tests/backend/backend.test.js",
    "test:syntax": "node scripts/check-syntax.js",
    "verify": "npm run test:backend && npm run prepare:fixture && npm run test:syntax",
    "test:all": "npm run test:backend && npm test",
    "login": "clasp login",
    "push": "clasp push --force",
    "deploy": "npm run test:all && clasp push --force && node scripts/clasp-version.js",
    "watch": "clasp push --watch"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@playwright/test": "^1.50.0",
    "docx": "^9.14.0",
    "exceljs": "^4.4.0"
  },
  "overrides": {
    "zod": "^4.6.6",
    "uuid": "^11.1.1",
    "glob": "^14.0.2"
  }
}
